{
  "cleanUrls": true,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://ws-fe.amazon-adsystem.com https://*.media-amazon.com https://*.ssl-images-amazon.com; connect-src 'self' https://oquuysfeistgpgrpeswq.supabase.co; font-src 'self'; object-src 'self' blob:; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guide",
      "destination": "/kodomo/guide",
      "permanent": true
    },
    {
      "source": "/builder",
      "destination": "/kodomo",
      "permanent": true
    },
    {
      "source": "/:theme/builder",
      "destination": "/:theme",
      "permanent": true
    },
    {
      "source": "/labels",
      "destination": "/kodomo/labels",
      "permanent": true
    },
    {
      "source": "/contribute.html",
      "destination": "/kakunin",
      "permanent": true
    },
    {
      "source": "/contribute",
      "destination": "/kakunin",
      "permanent": true
    }
  ]
}
