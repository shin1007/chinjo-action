{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/kodomo",
      "permanent": false
    },
    {
      "source": "/guide",
      "destination": "/kodomo/guide",
      "permanent": true
    },
    {
      "source": "/builder",
      "destination": "/kodomo/builder",
      "permanent": true
    },
    {
      "source": "/labels",
      "destination": "/kodomo/labels",
      "permanent": true
    }
  ]
}
